# ------------------------------------------------------------
# NyumbaHub — Production Environment Variables (Railway)
# ------------------------------------------------------------
# Copy these into your Railway project variables. Do NOT commit real secrets.
# Railway injects them at runtime; .env is only for local development.

# ---- Core Django ----
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-string
ALLOWED_HOSTS=nyumbahub.app,www.nyumbahub.app
CSRF_TRUSTED_ORIGINS=https://nyumbahub.app,https://www.nyumbahub.app
CORS_ALLOWED_ORIGINS=https://nyumbahub.app,https://www.nyumbahub.app

# ---- Database (Railway PostgreSQL provides DATABASE_URL automatically) ----
DATABASE_URL=postgres://user:password@host:port/database
DB_SSL_REQUIRE=False

# ---- Sessions (db = database-backed [recommended to start], redis = scale) ----
SESSION_BACKEND=db
# REDIS_URL=rediss://default:password@host:port   # only if SESSION_BACKEND=redis

# ---- Static & Media ----
USE_S3=True
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_STORAGE_BUCKET_NAME=nyumbahub-media
AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com  # uncomment for Cloudflare R2
AWS_DEFAULT_ACL=public-read
# MEDIA_URL=https://media.nyumbahub.app/   # optional CDN/custom domain override

# ---- Security ----
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

# ---- JWT ----
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# ---- Geocoding ----
GEOCODING_NOMINATIM_USER_AGENT=NyumbaHub-StudentHousing/1.0 (admin@nyumbahub.test)

# ---- Safaricom Daraja M-Pesa (PRODUCTION: use LIVE credentials, not sandbox) ----
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=your_live_consumer_key
MPESA_CONSUMER_SECRET=your_live_consumer_secret
MPESA_SHORTCODE=your_live_paybill_or_till_number
MPESA_PASSKEY=your_live_passkey
MPESA_CALLBACK_URL=https://nyumbahub.app/api/payments/callback/
MPESA_TIMEOUT=30
MPESA_FALLBACK_ON_TIMEOUT=False
MPESA_AUTO_CONFIRM_SIMULATION=False
